{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "title": "Neon night soft",
  "description": "Dark mode: slate-navy body, navy header, cyan buttons and a magenta accent.",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "base",
          "color": "#141a2e",
          "name": "Page background"
        },
        {
          "slug": "card",
          "color": "#1c2440",
          "name": "Card (raised)"
        },
        {
          "slug": "cream",
          "color": "#182039",
          "name": "Soft section background"
        },
        {
          "slug": "contrast",
          "color": "#eef2ff",
          "name": "Text"
        },
        {
          "slug": "muted",
          "color": "#b3bdd9",
          "name": "Muted text"
        },
        {
          "slug": "border",
          "color": "#2d3859",
          "name": "Border"
        },
        {
          "slug": "charcoal",
          "color": "#0b1020",
          "name": "Header and footer (navy)"
        },
        {
          "slug": "on-header",
          "color": "#e6ebff",
          "name": "Header text"
        },
        {
          "slug": "on-header-muted",
          "color": "#b3bdd9",
          "name": "Header muted text"
        },
        {
          "slug": "accent",
          "color": "#22d3ee",
          "name": "Accent (cyan)"
        },
        {
          "slug": "accent-dark",
          "color": "#22d3ee",
          "name": "Accent dark (buttons, links)"
        },
        {
          "slug": "accent-soft",
          "color": "#14324a",
          "name": "Accent soft (tints)"
        },
        {
          "slug": "accent-ink",
          "color": "#7deefb",
          "name": "Accent ink (price text)"
        },
        {
          "slug": "on-accent",
          "color": "#0b1020",
          "name": "Text on buttons"
        },
        {
          "slug": "secondary",
          "color": "#e879f9",
          "name": "Secondary (magenta)"
        },
        {
          "slug": "secondary-dark",
          "color": "#e879f9",
          "name": "Secondary dark (sale badge)"
        },
        {
          "slug": "success",
          "color": "#34d399",
          "name": "Success (green)"
        },
        {
          "slug": "success-soft",
          "color": "#123a33",
          "name": "Success soft"
        }
      ],
      "gradients": [
        {
          "slug": "sunrise",
          "gradient": "linear-gradient(135deg, #22d3ee 0%, #6366f1 100%)",
          "name": "Accent glow"
        },
        {
          "slug": "graphite",
          "gradient": "linear-gradient(160deg, #2a2a6a 0%, #141a2e 100%)",
          "name": "Call to action"
        },
        {
          "slug": "hero",
          "gradient": "linear-gradient(135deg, #0b1020 0%, #2a2a6a 100%)",
          "name": "Hero"
        }
      ]
    },
    "shadow": {
      "presets": [
        {
          "slug": "card",
          "shadow": "0 1px 2px rgba(0,0,0,0.06), 0 8px 24px rgba(0,0,0,0.06)",
          "name": "Card"
        },
        {
          "slug": "lift",
          "shadow": "0 2px 4px rgba(0,0,0,0.08), 0 16px 40px rgba(0,0,0,0.12)",
          "name": "Lift"
        }
      ]
    },
    "custom": {
      "accentHover": "#67e8f9",
      "darkButtonBg": "#22d3ee",
      "darkButtonText": "#0b1020",
      "darkButtonHover": "#67e8f9",
      "heroEyebrow": "#22d3ee",
      "heroCheck": "#34d399"
    }
  }
}
